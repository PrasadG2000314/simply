# ==============================================================================
# Production Environment Configuration (Deployment Template)
# ==============================================================================
# Rename this file to '.env' on your production server or pass via container environment.

NODE_ENV=production

# API Backend Configuration
PORT=5000
# MONGO_URI for docker compose is mongodb://db:27017/simply_db or external MongoDB Atlas URI
MONGO_URI=mongodb://db:27017/simply_db
JWT_SECRET=production_super_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_production_admin_password
ADMIN_JWT_SECRET=production_super_strong_random_admin_jwt_secret_here

# Domains & URLs
FRONTEND_URL=https://yourdomain.com
# For Nginx reverse proxy, relative /api path is recommended:
NEXT_PUBLIC_API_URL=/api

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
