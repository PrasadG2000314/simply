# ==============================================================================
# Development Environment Configuration (Local Testing)
# ==============================================================================
# Copy or use this file for local development.

NODE_ENV=development

# API Backend Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/simply_db
JWT_SECRET=dev_jwt_secret_key_change_in_prod_12345
JWT_EXPIRES_IN=7d

# Admin Credentials (Dev defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=dev_admin_jwt_secret_key_change_in_prod_12345

# URLs & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth Client ID (Optional for local dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_dev_google_client_id_here.apps.googleusercontent.com
