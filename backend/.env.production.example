# Backend Production Environment Variables Template
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://db:27017/simply_db
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_admin_password
ADMIN_JWT_SECRET=replace_with_secure_admin_jwt_secret

# Email / SMTP Configuration (Namecheap Private Email)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@turnipass.com
SMTP_PASS=replace_with_private_email_password
EMAIL_FROM="TurniPass Support <support@turnipass.com>"
